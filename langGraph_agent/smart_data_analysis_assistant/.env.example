# ============================================================
# ChatBI 项目环境变量配置模板
# 说明：带 <填写> 占位符的项需要你自己填入真实值。
#       本项目代码通过 load_dotenv() 读取本文件，请勿改变量名。
# ============================================================

# ---------- 1. 大模型 API Key ----------
# DeepSeek（chatbi_graph 主流程 / my_llm.py 使用）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 通义千问（mcp_server 内的辅助 LLM 调用使用，如意图识别、绘图代码生成）
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 2. PostgreSQL 数据库连接 ----------
db_host=localhost
db_port=5432
dbname=sales_chat
user=postgres
password=请填写你的数据库密码

# ---------- 3. MCP / API 服务地址 ----------
# 4 个 MCP 服务器所在的机器 IP（不带 http:// 前缀，代码会自动拼 http://ip:端口）
server_url=127.0.0.1
# FastAPI 接口所在的机器 IP（post_test.py 用）
server_api_url=127.0.0.1

# ---------- 4. 图片输出目录 ----------
# python_chart_mcp.py 里 matplotlib 生成的图表保存路径（必须是绝对路径）
IMAGE_DIR=C:/path/to/project/chatbi_graph/output
